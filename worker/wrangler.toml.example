name = "storybook-ai"
main = "src/index.js"
compatibility_date = "2026-10-17"

[[kv_namespaces]]
binding = "CHAT_LIMITS"
id = "部署時由 Cloudflare 產生的 KV namespace ID"

[vars]
AI_MODEL = "@cf/meta/llama-3.1-8b-instruct-fp8"

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "storybook-research"
database_id = "部署時由 Cloudflare 產生的 D1 database ID"
